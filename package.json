{
  "name": "my-playground",
  "private": true,
  "scripts": {
    "dev": "pnpm run -r --parallel --aggregate-output dev",
    "lint": "pnpm run -r --parallel lint",
    "typecheck": "pnpm run -r --parallel typecheck",
    "build": "pnpm run -r build",
    "test": "pnpm run -r --if-present test",
    "prepare": "husky"
  },
  "packageManager": "pnpm@12.5.1",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0"
  }
}
