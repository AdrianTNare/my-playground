# Any long random string; signs admin sessions. `openssl rand -hex 32`
PAYLOAD_SECRET=

# Local SQLite file by default. In production, the Turso database URL and token.
DATABASE_URL=file:./cms.db
DATABASE_AUTH_TOKEN=

# Public URL of this CMS (used for admin links).
CMS_URL=http://localhost:3030

# The playground, notified to refresh pages when content changes.
PLAYGROUND_URL=http://localhost:3000
REVALIDATE_SECRET=
