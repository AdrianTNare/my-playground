# Payload CMS to read booth content from. Unset: the bundled
# @playground/content is used, so the site works without a CMS.
CMS_URL=http://localhost:3030

# Shared with the CMS; it sends this when asking for a refresh.
REVALIDATE_SECRET=

# Override the Hashnode feed (tests point this at a dead URL).
HASHNODE_RSS_URL=
