    "daisyui": "^5.7.50",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.3",
    "prettier": "^3.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
