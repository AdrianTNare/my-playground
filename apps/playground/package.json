{
  "name": "@playground/site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@playground/content": "workspace:*",
    "@playground/contracts": "workspace:*",
    "@shikijs/rehype": "^4.5.0",
    "@tanstack/react-query": "^5.104.5",
    "fast-xml-parser": "^5.11.2",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "daisyui": "^5.7.50",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.3",
    "prettier": "^3.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "src/**/*.{js,ts,tsx}": "eslint --cache --fix",
    "src/**/*.{js,ts,tsx,css,md}": "prettier --write"
  }
}
